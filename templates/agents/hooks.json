{
  "host-infra-safety": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/check-host-infra-safety.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "shared-checkout-write": {
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash hooks/check-shared-checkout-write.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
